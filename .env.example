# ─────────────────────────────────────────────────────────────────────────────
# Environment variables for christfields2717.com
#
# HOW THIS WORKS (the secure setup, do not change it):
#   - Local dev:   copy this file to .env.local and fill in real values.
#                  .env.local is gitignored and must NEVER be committed.
#   - Production:  set these in Netlify -> Site settings -> Environment variables.
#   - This file (.env.example) holds PLACEHOLDERS ONLY. It is committed so the
#     team knows which variables exist. Never put a real value here.
#
# TWO KINDS OF KEYS:
#   - NEXT_PUBLIC_*  are PUBLIC by design. They are bundled into the browser and
#     are safe to be seen (publishable keys, public URLs). Not secrets.
#   - Everything else is a SECRET. It is read server-side only and must never
#     appear in client code, in this repo, or in any committed file.
# ─────────────────────────────────────────────────────────────────────────────


# ── Clerk: member dashboard auth ─────────────────────────────────────────────
# https://dashboard.clerk.com -> your app -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me   # PUBLIC (safe in browser)
CLERK_SECRET_KEY=sk_test_replace_me                    # SECRET (server only)

# Optional Clerk URL overrides. Defaults match the dashboard structure.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/dashboard/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/dashboard/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard


# ── Supabase: database (server-side, service role) ───────────────────────────
# https://supabase.com -> your project -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co   # PUBLIC (safe)
SUPABASE_SERVICE_ROLE_KEY=replace_me                        # SECRET (server only, bypasses RLS)


# ── Resend: transactional + feedback emails ──────────────────────────────────
# https://resend.com -> API Keys (after verifying the domain)
RESEND_API_KEY=re_replace_me                                # SECRET (server only)

# Optional. Defaults match Zoho / the Christ Fields inbox.
FROM_EMAIL="Christ Fields <proverbs@christfields2717.com>"
NOTIFY_EMAIL=proverbs@christfields2717.com
REPLY_TO_EMAIL=proverbs@christfields2717.com


# (The FaithFlow dashboard no longer calls an AI endpoint. The in-the-moment
#  "a verse for whatever you're facing" experience lives in GraceFlow, which the
#  dashboard links out to. No NVIDIA key is needed here.)


# ── Bible text source (memory-verse lookup) ──────────────────────────────────
# By default FaithFlow uses the public-domain World English Bible (NO key needed).
# To switch to the YouVersion Platform (richer translations, e.g. NIV) once your
# non-commercial app is APPROVED, set these and finish lib/bible/providers/youversion.ts.
# See docs/youversion-application.md.
# YOUVERSION_APP_KEY=          # the Platform app key (sent as X-YVP-App-Key)
# YOUVERSION_VERSION_ID=       # numeric Bible version id to read (e.g. the NIV)
# YOUVERSION_TRANSLATION=NIV   # short label shown next to verses
