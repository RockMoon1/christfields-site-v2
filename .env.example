# ─────────────────────────────────────────────────────────────────────────────
# Environment variables for christfields2717.com
#
# Copy this file to .env.local for local development. For production, set
# these in Netlify under Site settings → Environment variables.
# .env.local is gitignored and should never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Clerk (member dashboard auth) ────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your app → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Optional Clerk URL overrides. Defaults below match the dashboard structure.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/dashboard/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/dashboard/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard

# ── Resend (transactional thank-you emails on form submissions) ──────────────
# Get from https://resend.com → API Keys after verifying the domain.
RESEND_API_KEY=re_replace_me

# Optional. Defaults match Zoho.
FROM_EMAIL="Christ Fields <proverbs@christfields2717.com>"
REPLY_TO_EMAIL=proverbs@christfields2717.com
